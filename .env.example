# KisanLink Environment Variables Example
# Copy this file to .env and configure your keys

# Google Gemini API Key (Gemini 3.5 Flash-Lite / Gemini 3 Flash Preview)
VITE_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Server Port (defaults to 3001)
PORT=3001
